<%
     _class_name = template.get_orm_class_name(scheme)
     _cache_key_type = template.get_primary_cache_key_type(scheme)
     _cute_master_group = scheme.csv_source.sub(/.csv$/, '') != scheme.qualified_name
     _is_dictionary = scheme.primary_keys.count > 0

     def _get_type(item)
         _class_name = template.get_orm_class_name(scheme)
         if item.is_enum?
             type = "#{scheme.namespace_of_enum}.#{item.enum_name.to_s.sub(/^e/, '')}"
         else
             type = template.rawtype_of_item(item)
         end
         type
     end

     def _get_name(item)
         name = template.name_of_item(item).camel_case
     end

     def _get_raw_name(item)
         name = template.name_of_item(item)
     end
-%>
/// Caution!
/// This file is generated by MasterDataImporter.cs
/// Do not change this file manually

#pragma warning disable 0649

using System;
using System.Linq;
using System.Collections.Generic;
using UnityEngine;
using Cute.Master;
<% if _is_dictionary or _cute_master_group -%>
using SerializableCollections;
<% end -%>

namespace <%= scheme.namespace_of_master %>
{
    [Serializable]
    public class <%= _class_name %>Element : IMasterElement
    {
        
<% template.used_unhooked_items(scheme).each do |item|
    _raw_type = _get_type(item)
    _public_name = _get_name(item)
    _private_name = '_' + _public_name
-%>
        [SerializeField]
        <%= _raw_type %> <%= _private_name %>;
<% end -%>

<% template.used_unhooked_items(scheme).each do |item|
    _raw_type = _get_type(item)
    _public_name = _get_name(item)
    _private_name = '_' + _public_name
-%>
    <%- if item.is_localized? -%>
        public string <%= _public_name %> { get { return MasterUtil.Localize(<%= _private_name %>); } }
    <%- else -%>
        public <%= _raw_type %> <%= _public_name %> { get { return <%= _private_name %>; } }
    <%- end -%>
<% end -%>

#if UNITY_EDITOR
        public override void SetData(string[] values, int[] indexes)
        {
<% _i = 0
   template.used_unhooked_items(scheme).each do |item|
    _raw_type = _get_type(item)
    _public_name = _get_name(item)
    _private_name = '_' + _public_name
    if item.is_enum?
        _converter = "ToEnum<#{_raw_type}>"
    else
        _converter = "To#{_raw_type.capitalize.sub(/\[\]/,'Array')}"
    end
-%>
            <%= _private_name %> = MasterUtil.<%= _converter %>(values, indexes, <%= _i %>);
<% _i += 1 -%>
<% end -%>

        }
#endif
    }

<% if _is_dictionary -%>
    [Serializable]
    public class <%= _class_name %>Dictionary : SerializableDictionary<<%= _cache_key_type %>, <%= _class_name %>Element> { }
<% end -%>

<% if _cute_master_group -%>
    [Serializable]
    public class <%= _class_name %> : IMasterGroupElement
<% else -%>
    public class <%= _class_name %> : IMaster<<%= _class_name %>>
<% end -%>
    {

        [SerializeField]
<% if _is_dictionary -%>
        <%= _class_name %>Dictionary dict = new <%= _class_name %>Dictionary();
        public <%= _class_name %>Dictionary Dict
        {
            get
            {
                return dict;
            }
        }

        public <%= _class_name %>Dictionary.ValueCollection List
        {
            get
            {
                return dict.Values;
            }
        }
<% else -%>
        List<<%= _class_name %>Element> list = new List<<%= _class_name %>Element>();
        public List<<%= _class_name %>Element> List
        {
            get
            {
                return list;
            }
        }
<% end -%>

#if UNITY_EDITOR
        public <% if !_cute_master_group %>override <% end %>void AddData(string[] values, int[] indexes)
        {
            var e = new <%= _class_name %>Element();
            e.SetData(values, indexes);
<% if _is_dictionary -%>
            dict.Add(e.Id, e);
<% else -%>
            list.Add(e);
<% end -%>
        }
<% if !_cute_master_group -%>

        /// <summary>データを消去</summary>
        public override void ClearData()
        {
<% if _is_dictionary -%>
            dict.Clear();
            dict.TrimExcess();
<% else -%>
            list.Clear();
<% end -%>
        }

        public override int[] GetPropertyIndex(string[] values)
        {
            string[] name = new string[] {
<%   template.used_unhooked_items(scheme).each do |item| -%>
                "<%= _get_raw_name(item) %>",
<% end -%>
            };
            int[] result = new int[<%= template.used_unhooked_items(scheme).count %>];
            for (int i = 0; i < <%= template.used_unhooked_items(scheme).count %>; i++)
            {
                result[i] = Array.FindIndex(values, v => v == name[i]);
                if (MasterUtil.IsStrictImport && result[i] < 0)
                {
                    throw new Exception("<%= _class_name %>." + name[i] + " is not found");
                }
            }

            return result;
        }
<% end -%>
<% if _is_dictionary -%>

        [UnityEditor.CustomPropertyDrawer(typeof(<%= _class_name %>Dictionary))]
        public class <%= _class_name %>DictionaryPropertyDrawer : SerializableDictionaryPropertyDrawer { }
<% end -%>
#endif
    }
<% if _cute_master_group -%>

    [Serializable]
    public class <%= _class_name %>GroupDictionary : SerializableDictionary<int, <%= _class_name %>> { }

    public class <%= _class_name %>Group : IMasterGroup<<%= _class_name %>, <%= _class_name %>Group, <%= _class_name %>GroupDictionary>
    {
#if UNITY_EDITOR
        public override int[] GetPropertyIndex(string[] values)
        {
            string[] name = new string[] {
<%   template.used_unhooked_items(scheme).each do |item| -%>
                "<%= _get_raw_name(item) %>",
<% end -%>
            };
            int[] result = new int[<%= template.used_unhooked_items(scheme).count %>];
            for (int i = 0; i < <%= template.used_unhooked_items(scheme).count %>; i++)
            {
                result[i] = Array.FindIndex(values, v => v == name[i]);
                if (MasterUtil.IsStrictImport && result[i] < 0)
                {
                    throw new Exception("<%= _class_name %>." + name[i] + " is not found");
                }
            }

            return result;
        }

        [UnityEditor.CustomPropertyDrawer(typeof(<%= _class_name %>GroupDictionary))]

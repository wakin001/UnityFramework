<%
     _class_name = template.get_data_class_name(scheme)
     def _get_type(item)
         if item.is_enum?
             type = "#{scheme.namespace_of_enum}.#{item.enum_name.to_s.sub(/^e/, '')}"
         else
             type = template.rawtype_of_item(item)
         end
         type
     end
     def _get_name(item)
         name = template.name_of_item(item).camel_case
     end
     def _get_raw_name(item)
         name = template.name_of_item(item)
     end
-%>
/// Caution!
/// This file is generated by MasterDataImporter.cs
/// Do not change this file manually

using System;
using Cute.Master;
using UnityEditor;

namespace <%= scheme.namespace_of_master %>
{
    public class <%= _class_name %>Element : IEditorMasterElement
    {

<% template.used_unhooked_items(scheme).each do |item|
    _raw_type = _get_type(item)
    _public_name = _get_name(item)
    _private_name = '_' + _public_name
-%>
        <%= _raw_type %> <%= _private_name %>;
<% end -%>

<% template.used_unhooked_items(scheme).each do |item|
    _raw_type = _get_type(item)
    _public_name = _get_name(item)
    _private_name = '_' + _public_name
-%>
    <%- if item.is_localized? -%>
        public string <%= _public_name %> { get { return MasterUtil.Localize(<%= _private_name %>); } }
    <%- else -%>
        public <%= _raw_type %> <%= _public_name %> { get { return <%= _private_name %>; } }
    <%- end -%>
<% end -%>

        public override void SetInfo(string[] values, int[] indexes)
        {
            if (values.Length >= <%= template.used_unhooked_items(scheme).count %>)
            {
<% _i = 0
   template.used_unhooked_items(scheme).each do |item|
    _raw_type = _get_type(item)
    _public_name = _get_name(item)
    _private_name = '_' + _public_name
    if item.is_enum?
        _converter = "ToEnum<#{_raw_type}>"
    else
        _converter = "To#{_raw_type.capitalize.sub(/\[\]/,'Array')}"
    end
-%>
                <%= _private_name %> = MasterUtil.<%= _converter %>(values, indexes, <%= _i %>);
<% _i += 1 -%>
<% end -%>

            }
        }
    }

    public class <%= _class_name %> : IEditorMaster<<%= _class_name %>Element>
    {
        const string path = "<%= scheme.csv_path + scheme.csv_source.sub(/^[^\/]*\//, "/") %>";

        private static <%= _class_name %> instance = null;
        public static <%= _class_name %> Instance
        {
            get
            {
                if (instance == null)
                {
                    instance = new <%= _class_name %>();
                    instance.Deserialize(path);
                }
                return instance;
            }
        }

        public override int[] GetPropertyIndex(string[] values)
        {
            int[] indexes = new int[<%= template.used_unhooked_items(scheme).count %>];
            string[] names = new string[] { <%- template.used_unhooked_items(scheme).each do |item| -%>"<%= _get_raw_name(item) %>", <%- end %>};

            for (int i = 0; i < <%= template.used_unhooked_items(scheme).count %>; ++i)
            {
                indexes[i] = Array.FindIndex(values, v => v == names[i]);
            }

            return indexes;
        }

        private <%= _class_name %>()
        {
        }

        class Postprocess : AssetPostprocessor
        {
            public static void OnPostprocessAllAssets(string[] importedAssets, string[] deletedAssets, string[] movedAssets, string[] movedFromAssetsPath)
            {
                if (instance == null)
                {
                    return;
                }

                if (Array.Find(importedAssets, asset => asset == path) != null)
                {
                    instance = null;
                }
            }
        }
    }
}
